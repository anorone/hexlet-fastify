doctype html
html(lang='en')
  head
    title Page title
  body
    header(style='display: flex')
      h1(style='margin: 0') Logo
      a(href=route('root')) Home
      if username
        span= username
      else
        a(href=route('login')) Enter
    main
      block content
    footer(style='display: flex')
      a(href='https://github.com/anorone', style='margin: auto') GitHub
